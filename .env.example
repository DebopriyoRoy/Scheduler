DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_HTTPS=false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

SQUARE_ENVIRONMENT=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2026-08-19
SQUARE_REQUEST_TIMEOUT_SECONDS=15
SQUARE_PRODUCTION_WRITES_ENABLED=false
SQUARE_PRODUCTION_PILOT_VERIFIED=false
SQUARE_PUBLISHING_ENABLED=false


