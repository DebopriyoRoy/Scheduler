# Copy to .env and fill in. .env is git-ignored and must never be committed:
# it carries a live Square access token.
#
#     cp .env.example .env
#
# Paste your own values in with an editor. Nobody else should ever handle them,
# and a token that has been shared anywhere should be rotated in the Square
# dashboard before use.

# --- Django -----------------------------------------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# true while developing; the packaged app sets its own.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave unset to use db.sqlite3 in this folder.
# DATABASE_URL=sqlite:///db.sqlite3

# --- Square -----------------------------------------------------------------
# From the Square dashboard: Developer > Applications > your app > Credentials.
SQUARE_ENVIRONMENT=production
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_PRODUCTION_ACCESS_TOKEN=
# Dashboard > Locations. Needed before a schedule can be previewed or synced.
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2025-01-23
SQUARE_REQUEST_TIMEOUT_SECONDS=30

# --- Safety rails -----------------------------------------------------------
# Writes create unpublished drafts only. Publishing to staff stays manual, in
# Square, by a manager - the application has no publish call at all, and
# assert_publishing_disabled() raises if this is ever turned on.
SQUARE_PRODUCTION_WRITES_ENABLED=false
SQUARE_PRODUCTION_PILOT_VERIFIED=false
SQUARE_PUBLISHING_ENABLED=false

# --- Outgoing email (password reset codes) ----------------------------------
# Gmail refuses an ordinary account password over SMTP. EMAIL_HOST_PASSWORD must be a
# Google App Password: myaccount.google.com > Security > 2-Step Verification >
# App passwords. Generate it yourself and paste it here; it is a credential and this
# file is git-ignored for that reason.
#
# Leave EMAIL_HOST_PASSWORD blank and the reset falls back to writing the code to a
# file in the application's data folder, so a machine with no mail set up still works.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=debopriyo.inbox@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=debopriyo.inbox@gmail.com

# Where a reset code goes when the account being reset has no address of its own.
PASSWORD_RESET_FALLBACK_EMAIL=debopriyo.inbox@gmail.com
